# ============================================
# Legacy Python/Streamlit app (old_version/legacy/)
# ============================================
__pycache__/
*.py[cod]
*$py.class

# Personal player data — never commit
old_version/legacy/databases/*.db
old_version/legacy/backups/

# User config and assets
old_version/legacy/config/config*
old_version/legacy/config/assets/logo.png
old_version/legacy/config/assets/flag.png

# Streamlit local files
old_version/legacy/.streamlit/secrets.toml
old_version/legacy/.streamlit/config.toml

# Launcher runtime files
old_version/legacy/launcher.log
old_version/legacy/.streamlit_server.pid
old_version/legacy/*.bat

# Virtual environments
venv/
.venv/
env/
.env/

# ============================================
# C++/Qt app (old_version/desktop/)
# ============================================
old_version/desktop/build*/
old_version/desktop/installer/Output/
old_version/desktop/installer/output/
old_version/desktop/installer/staging/
old_version/desktop/translations/*.qm
old_version/desktop/src/tests/golden/local/
CMakeUserPresets.json
CMakeLists.txt.user*

# ============================================
# IDE / misc
# ============================================
.idea/
.vscode/
aqtinstall.log
*.log
.qtcreator/
